{
  "schemaVersion": 1,
  "renderer": {
    "name": "nimbus",
    "config": "docs-nimbus/astro.config.ts"
  },
  "collections": [
    {
      "id": "project",
      "title": "Documentation du projet",
      "visibility": "internal",
      "include": ["*.md"]
    },
    {
      "id": "decisions",
      "title": "Décisions",
      "visibility": "internal",
      "include": ["docs/decisions/**/*.md"]
    },
    {
      "id": "foundation",
      "title": "Socle vendorisé",
      "visibility": "reference",
      "include": ["docs/foundation/**/*.md"]
    },
    {
      "id": "nimbus-maintenance",
      "title": "Maintenance Nimbus",
      "visibility": "reference",
      "include": ["docs-nimbus/AGENT.md"]
    }
  ],
  "ignored": [
    {
      "pattern": "node_modules/**/*.md",
      "reason": "Dépendances tierces"
    },
    {
      "pattern": "dist/**/*.md",
      "reason": "Sorties générées"
    },
    {
      "pattern": "build/**/*.md",
      "reason": "Sorties générées"
    },
    {
      "pattern": ".venv/**/*.md",
      "reason": "Environnement Python local"
    },
    {
      "pattern": "docs-nimbus/src/content/docs/**/*.md",
      "reason": "Collection Nimbus générée depuis les sources classées"
    },
    {
      "pattern": "docs-nimbus/node_modules/**/*.md",
      "reason": "Dépendances Nimbus tierces"
    },
    {
      "pattern": "docs-nimbus/dist/**/*.md",
      "reason": "Site Nimbus généré"
    }
  ]
}
