#!/usr/bin/env python3
"""Verify the OCI manifest for a Mon Florian application release."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

from release_contract import ContractError, verify_release_manifest  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--expected-digest", required=True)
    parser.add_argument("--release", required=True)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--created", required=True)
    arguments = parser.parse_args()
    try:
        verify_release_manifest(
            Path(arguments.manifest),
            arguments.expected_digest,
            Path(arguments.release),
            arguments.revision,
            arguments.created,
        )
    except (ContractError, OSError) as exc:
        print(f"application release manifest verification refused: {exc}", file=sys.stderr)
        return 1
    print("application release OCI manifest matches the exact Atlas contract")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
