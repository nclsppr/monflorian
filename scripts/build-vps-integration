#!/usr/bin/env python3
"""Build the deterministic Mon Florian integration artifact."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_ROOT = Path(__file__).resolve().parent
REPOSITORY_ROOT = SCRIPT_ROOT.parent
sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

from release_contract import (  # noqa: E402
    ContractError,
    append_github_outputs,
    build_integration,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--component-images", required=True)
    parser.add_argument("--output-directory", required=True)
    parser.add_argument("--github-output")
    arguments = parser.parse_args()
    try:
        values = build_integration(
            REPOSITORY_ROOT,
            Path(arguments.output_directory),
            arguments.revision,
            Path(arguments.component_images),
        )
        if arguments.github_output:
            append_github_outputs(Path(arguments.github_output), values)
    except (ContractError, OSError) as exc:
        print(f"integration build refused: {exc}", file=sys.stderr)
        return 1
    print(f"integration package built for {values['revision']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
