#!/usr/bin/env python3
"""Verify one immutable Atlas application release descriptor."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

from release_contract import ContractError, verify_application_release  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--release", required=True)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--expected-images", required=True)
    parser.add_argument("--integration-reference", required=True)
    parser.add_argument("--migrations", required=True)
    parser.add_argument("--probes", required=True)
    arguments = parser.parse_args()
    try:
        verify_application_release(
            Path(arguments.release),
            arguments.revision,
            Path(arguments.expected_images),
            arguments.integration_reference,
            Path(arguments.migrations),
            Path(arguments.probes),
        )
    except (ContractError, OSError) as exc:
        print(f"application release verification refused: {exc}", file=sys.stderr)
        return 1
    print("application release matches the exact Mon Florian Atlas contract")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
